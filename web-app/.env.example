# Copia este archivo como .env y rellena con tus valores de Firebase.
# Console > Configuracion del proyecto > Tus apps > Web (</>) > firebaseConfig
# NUNCA subas el archivo .env real al repositorio.
VITE_FIREBASE_API_KEY=TU_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=TU_PROYECTO.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://TU_PROYECTO-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=TU_PROYECTO
VITE_FIREBASE_STORAGE_BUCKET=TU_PROYECTO.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=TU_SENDER_ID
VITE_FIREBASE_APP_ID=TU_APP_ID
